/node_modules
/vendor
.DS_Store
.idea
.vscode
*.log

# Never commit environment files. The spec forbids a production .env ever
# entering this repository; the ignore rule is the first line of that defence.
.env
.env.*
!.env.example

/apps/*/node_modules
/apps/*/public/hot
/apps/*/storage/*.key
/apps/*/storage/logs

# docs-site is a VitePress build - the site output and its cache are
# regenerated by `make docs`/CI, never hand-edited, and the API reference it
# builds from (docs-site/api/classes/*.md) IS committed since it is meant to
# be readable straight from a GitHub checkout, not only from the deployed site.
/docs-site/node_modules
/docs-site/.vitepress/dist
/docs-site/.vitepress/cache

# `public/build/` IS COMMITTED. `vendor/` IS NOT, AND THE CLONE TEST IS WHY.
#
# THIS REPOSITORY IS THE PRODUCT. The two packages are consumed by local PATH -
# `composer.json` points at `../../packages/panel`, `package.json` at
# `file:../../packages/ui` - so they resolve INSIDE this tree and were never
# coming from a registry. Committing the dependencies and the built assets on
# top of that makes a clone runnable with no `composer install` and no
# `npm run build`:
#
#     git clone <repo> myapp && cd myapp/apps/playground
#     cp .env.example .env && php artisan key:generate
#     php artisan migrate --seed && php artisan panel:permissions sync
#
# WHAT THIS COSTS, so nobody is surprised later:
#
#   - `vendor/` is ~50-80 MB. Fine for a template; heavy if you branch a lot.
#   - SECURITY UPDATES BECOME MANUAL. Nothing tells you a dependency has a CVE;
#     you run `composer update` yourself and commit the result.
#   - MERGE CONFLICTS INSIDE `vendor/` ARE NOT RESOLVABLE in practice. Take one
#     side wholesale and re-run `composer install`.
#
# `node_modules` STAYS IGNORED and that asymmetry is deliberate: it is needed to
# REBUILD assets, never to run them, and it is the tree that carries
# platform-specific binaries. A `node_modules` committed from Windows breaks on
# a Linux host - this project has already lost a day to exactly that with
# rollup.
#
# `vendor/` WAS COMMITTED AND THEN DROPPED, MEASURED RATHER THAN ARGUED. Cloning
# with it in the tree FAILS ON WINDOWS: `vendor/aws/aws-sdk-php` and
# `vendor/phpunit` carry paths up to 155 characters, which blows the 260-char
# MAX_PATH once the repository sits anywhere but the drive root. The clone
# ABORTS PARTWAY - `git` reports "Filename too long" and leaves an incomplete
# working tree, which reads as a corrupt repository rather than a missing
# setting.
#
# It can be worked around with `git config --global core.longpaths true`, and
# that is the wrong trade: 16,000 files to save one `composer install`, paid for
# with a global git setting every Windows user must know to set BEFORE their
# first clone, and a baffling failure when they do not.
/apps/*/vendor

#
# NOT `/apps/*/storage/framework`, WHICH IS HOW THIS WAS WRITTEN AND WHY A
# FRESH CLONE COULD NOT RUN ITS OWN TESTS.
#
# That one line ignored the DIRECTORIES, not just their contents, so a clone had
# no `storage/framework/views` at all - and the first thing anybody runs, the
# suite, failed 279 tests with "Please provide a valid cache path". The message
# names a configuration value, so it reads as a misconfiguration; nothing in it
# points at a missing directory. Found by cloning this repository and running
# the suite the way CI does, which nobody had done.
#
# Laravel's skeleton already ships a `.gitignore` inside each of these
# directories that ignores their contents and keeps the directory. Those files
# are now tracked, and this rule stays out of their way.
#
/apps/*/storage/framework/testing/*.php
/apps/*/bootstrap/cache/*.php

/packages/*/node_modules
/packages/*/vendor

# A LIBRARY PINS NOTHING. `packages/panel` is consumed through a
# `composer require`, where the CONSUMER's lock decides versions - a lock
# committed here would be resolved against and then ignored, while quietly
# going stale. Filament keeps a lock at the monorepo root only, for the same
# reason.
/packages/*/composer.lock

# packages/ui/dist IS committed, deliberately - it is what an external
# consumer's package.json points a `file:` dependency at (see
# InstallCommand::scaffoldPackageJson()). Without it, `panel:install` finishes
# and `npm run build` has nothing to import: the exact gap the probe found.

# Local scratch — seed dumps, profiling output, bundle-size reports
/.scratch

# Seeded demo database — 692 MB of generated data, regenerate with panel:seed-demo
*.sqlite
*.sqlite-journal

# The push credential. It lives in the working tree and must never leave it -
# a token committed here is a token GitHub revokes and a stranger uses first.
/githubkey.md

# Chrome for Testing, downloaded for the browser suite.
apps/playground/chrome/
apps/playground/database/dusk.sqlite
apps/playground/public/hot.dusk-stashed

# Screenshot captures are regenerated by scripts/shots.sh - the reference lives locally
/.shots/

# THE PATH-REPO LINK IS NEVER COMMITTED, even though the rest of `vendor/` is.
#
# `vendor/panelkit/panel` IS A WINDOWS JUNCTION to `packages/panel`, created by
# composer's path repository. Git does not record it as a link - it FOLLOWS it
# and stages 341 real files, so the package source lands in the repository
# twice.
#
# WHAT THAT BREAKS ON A CLONE. The clone gets a real directory where a link
# should be, so `packages/panel` - the copy people edit - is shadowed by a
# frozen snapshot of itself, and `composer install` then wants to replace a
# non-empty directory it did not create. Editing the package would appear to do
# nothing.
#
# Composer recreates the link from `composer.json`, so there is nothing here
# worth carrying. Same reasoning for the UI package under `node_modules`, which
# is ignored wholesale already.

# Local vendor research clones (not part of the release)
temp/
vendor/research/

# Local vendor / research trees (never ship)
erpgosaas/
tmp/

# Same as erpgosaas/ above - scratch installs that were committed by accident
# before this rule existed. scripts/split.sh already documents temp-filament
# as untracked scratch content; testfolder carries no first-party code at
# all, only vendor/node_modules/bootstrap/storage bloat.
temp-filament/
testfolder/

# Downloaded reference scripts, kept locally for comparison only - never ship.
codecanyon-Z4btd3XY-erpgo-saas-all-in-one-business-erp-with-project-account-hrm-crm-pos/
whatsml/
